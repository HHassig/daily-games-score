<%# One compact Pips tile for game grids: a row per difficulty for the day. %>
<% rows = pips_games.map { |g| [g, Result.find_by(game: g, user: user, gameday_id: gameday.id)] } %>
<div class="flex flex-col items-center rounded-xl bg-white p-4 text-center shadow-sm ring-1 ring-gray-950/5 <%= "opacity-70" if rows.all? { |_, r| r.nil? } %>">
  <%= image_tag pips_games.first.logo, alt: "Pips", class: "mb-2 h-12 w-12 rounded-lg" %>
  <%= link_to "Pips", game_path(pips_games.first.name, date: gameday.date), class: "font-bold text-gray-900 hover:text-indigo-600" %>
  <% if rows.any? { |_, r| r } %>
    <div class="mt-1 flex flex-col gap-0.5">
      <% rows.each do |game, result| %>
        <% next if result.nil? %>
        <div class="flex items-baseline justify-between gap-3 text-sm">
          <span class="text-gray-500"><%= game.display_name.sub("Pips ", "") %></span>
          <%= link_to display_score(game, result), game_result_path(game.name, result), class: "font-mono font-bold tabular-nums text-indigo-600 hover:text-indigo-500" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="mt-2 flex gap-2">
      <%= link_to "Play", pips_games.first.url, target: "_blank", class: "rounded-md bg-indigo-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-indigo-500" %>
      <%= link_to "Record", new_game_result_path(pips_games.first.name), class: "rounded-md bg-white px-2.5 py-1 text-xs font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
