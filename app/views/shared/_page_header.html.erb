<div class="mb-6 mt-2 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl"><%= title %></h1>
    <% if defined?(subtitle) && subtitle.present? %>
      <p class="mt-1 text-sm text-gray-500"><%= subtitle %></p>
    <% end %>
  </div>
  <% if defined?(gameday) && gameday %>
    <%= render "shared/date_nav", gameday: gameday %>
  <% end %>
</div>
