<% content_for :title, "#{@game.display_name} · Daily Games" %>
<div class="mb-6 mt-2 flex flex-wrap items-end justify-between gap-3">
  <div class="flex items-center gap-3">
    <%= (image_tag @game.logo, alt: @game.name, class: "h-12 w-12 rounded-lg") unless @game.logo.nil? %>
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl"><%= pips?(@game) ? "Pips" : @game.display_name %></h1>
      <% if pips?(@game) %>
        <div class="mt-1 flex rounded-lg bg-gray-100 p-0.5" style="width:fit-content">
          <% %w[pips-easy pips-medium pips-hard].each do |name| %>
            <% sibling = Game.find_by(name: name) %>
            <% next if sibling.nil? %>
            <%= link_to sibling.display_name.sub("Pips ", ""), game_path(sibling.name, date: @gameday.date),
                  class: "rounded-md px-2 py-1 text-xs font-semibold " + (sibling == @game ? "bg-white text-gray-900 shadow-sm" : "text-gray-500 hover:text-gray-800") %>
          <% end %>
        </div>
      <% end %>
      <div class="mt-0.5 flex gap-3 text-sm">
        <%= link_to "Play ↗", @game.url, target: "_blank", class: "font-semibold text-indigo-600 hover:underline" %>
        <% if user_signed_in? %>
          <%= link_to "My history", game_results_path(@game.name), class: "text-gray-500 hover:text-gray-800 hover:underline" %>
          <%= link_to "Record score", new_game_result_path(@game.name), class: "text-gray-500 hover:text-gray-800 hover:underline" %>
        <% end %>
      </div>
    </div>
  </div>
  <%= render "shared/date_nav", gameday: @gameday %>
</div>

<%
  day_results = Result.includes(:user).where(game: @game, gameday_id: @gameday.id).order(:timer)
  cards = day_results.map { |r| { user: r.user, result: r } }
  if current_user && day_results.none? { |r| r.user_id == current_user.id }
    cards << { user: current_user, result: nil }
  end
  best = cards.filter_map { |c| c[:result]&.timer }.min
%>
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% cards.each do |card| %>
    <div class="flex flex-col rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-950/5">
      <div class="flex items-center justify-between">
        <%= link_to card[:user].username, user_path(card[:user].username), class: "text-lg font-bold text-gray-900 hover:text-indigo-600" %>
        <% if card[:result] && best && card[:result].timer == best %>
          <span title="Best of the day">👑</span>
        <% end %>
      </div>
      <% average = Average.find_by(game: @game, user: card[:user]) %>
      <p class="mt-0.5 text-xs text-gray-500">Average: <%= average&.score&.positive? ? (@game.timed? ? format_seconds(average.score) : average.score.round(2)) : "—" %></p>
      <% if card[:result] %>
        <p class="mt-2 font-mono text-2xl font-bold tabular-nums text-indigo-600">
          <%= link_to display_score(@game, card[:result]), game_result_path(@game.name, card[:result]) %>
        </p>
        <div class="mt-2 whitespace-pre-line break-words text-sm leading-6 text-gray-700"><%= ParseScore.new(card[:result].score).parse.join("\n") %></div>
      <% else %>
        <p class="mt-4 text-sm text-gray-400">Nothing recorded.</p>
      <% end %>
    </div>
  <% end %>
</div>
