<% content_for :title, "My games · Daily Games" %>
<%= render "shared/page_header", title: "My games", gameday: @gameday %>

<% if @games.empty? %>
  <div class="rounded-xl bg-white px-6 py-12 text-center shadow-sm ring-1 ring-gray-950/5">
    <p class="text-3xl">🎮</p>
    <p class="mt-2 font-medium text-gray-700">No games yet.</p>
    <p class="mt-1 text-sm text-gray-500">Play one from <%= link_to "All games", all_games_path, class: "text-indigo-600 hover:underline" %> and send the share text to the <%= link_to "Telegram bot", telegram_setup_path, class: "text-indigo-600 hover:underline" %>.</p>
  </div>
<% end %>

<% pips_games, regular_games = @games.partition { |g| pips?(g) } %>
<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
  <%= render "shared/pips_tile", pips_games: pips_games, user: current_user, gameday: @gameday if pips_games.any? %>
  <% regular_games.each do |game| %>
    <% result = Result.find_by(game: game, user: current_user, gameday_id: @gameday.id) %>
    <div class="flex flex-col items-center rounded-xl bg-white p-4 text-center shadow-sm ring-1 ring-gray-950/5 <%= "opacity-70" if result.nil? %>">
      <%= (image_tag game.logo, alt: game.name, class: "mb-2 h-12 w-12 rounded-lg") unless game.logo.nil? %>
      <%= link_to game.display_name, game_path(game.name, date: @gameday.date), class: "font-bold text-gray-900 hover:text-indigo-600" %>
      <% if result %>
        <%= link_to display_score(game, result), game_result_path(game.name, result), class: "mt-1 font-mono text-2xl font-bold tabular-nums text-indigo-600 hover:text-indigo-500" %>
      <% else %>
        <div class="mt-2 flex gap-2">
          <%= link_to "Play", game.url, target: "_blank", class: "rounded-md bg-indigo-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-indigo-500" %>
          <%= link_to "Record", new_game_result_path(game.name), class: "rounded-md bg-white px-2.5 py-1 text-xs font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
