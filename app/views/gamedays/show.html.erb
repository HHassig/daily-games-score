<% content_for :title, "#{@gameday.date} · Daily Games" %>
<%= render "shared/page_header", title: "My games", gameday: @gameday %>

<% pips_results, regular_results = @results.partition { |r| pips?(r.game) } %>
<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
  <%= render "shared/pips_tile", pips_games: pips_results.map(&:game), user: current_user, gameday: @gameday if pips_results.any? %>
  <% regular_results.each do |result| %>
    <% game = result.game %>
    <div class="flex flex-col items-center rounded-xl bg-white p-4 text-center shadow-sm ring-1 ring-gray-950/5">
      <%= (image_tag game.logo, alt: game.name, class: "mb-2 h-12 w-12 rounded-lg") unless game.logo.nil? %>
      <%= link_to game.display_name, game_path(game.name, date: @gameday.date), class: "font-bold text-gray-900 hover:text-indigo-600" %>
      <%= link_to display_score(game, result), game_result_path(game.name, result), class: "mt-1 font-mono text-2xl font-bold tabular-nums text-indigo-600 hover:text-indigo-500" %>
    </div>
  <% end %>
</div>
