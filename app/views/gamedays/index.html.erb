<% content_for :title, "Day history · Daily Games" %>
<%= render "shared/page_header", title: "Day history" %>

<div class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-950/5">
  <ul class="divide-y divide-gray-100">
    <% @gamedays.each do |gameday| %>
      <% games = GamesThisDay.new(gameday, current_user).games %>
      <li>
        <%= link_to gameday.date == Date.today.strftime("%Y-%m-%d") ? games_path : gameday_path(gameday.date), class: "flex items-center justify-between gap-3 px-4 py-3 hover:bg-gray-50" do %>
          <span class="font-semibold text-gray-900"><%= gameday.date %></span>
          <span class="flex flex-wrap items-center justify-end gap-1">
            <% games.each do |game| %>
              <%= (image_tag game.logo, alt: game.display_name, title: game.display_name, class: "h-6 w-6 rounded") unless game.logo.nil? %>
            <% end %>
            <span class="ml-2 w-8 text-right text-sm tabular-nums text-gray-500"><%= games.size %></span>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
