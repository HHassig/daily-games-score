<% content_for :title, "Leaderboards · Daily Games" %>
<%= render "shared/page_header", title: "Leaderboards", gameday: @gameday %>

<% if @presenter.played.any? || @presenter.pips %>
  <% champs = @presenter.champions %>
  <% if champs.any? %>
    <% top_wins = champs.first.last %>
    <div class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-xl bg-white px-4 py-3 shadow-sm ring-1 ring-gray-950/5">
      <span class="text-xl">👑</span>
      <% champs.each do |user, wins| %>
        <span class="inline-flex items-center gap-1.5 rounded-full <%= wins == top_wins ? "bg-amber-100 text-amber-900" : "bg-gray-100 text-gray-600" %> px-3 py-1 text-sm font-semibold">
          <%= link_to user.username, user_path(user.username) %>
          <span class="font-normal"><%= wins %> <%= "win".pluralize(wins) %></span>
        </span>
      <% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <%= render "shared/pips_board", pips_boards: @presenter.pips, gameday: @gameday if @presenter.pips %>
    <% @presenter.played.each do |board| %>
      <% game = board[:game] %>
      <div class="flex flex-col rounded-xl bg-white p-4 shadow-sm ring-1 ring-gray-950/5">
        <div class="mb-3 flex items-center gap-3">
          <%= (image_tag game.logo, alt: game.name, class: "h-10 w-10 rounded-lg") unless game.logo.nil? %>
          <%= link_to game.display_name, game_path(game.name, date: @gameday.date), class: "truncate text-lg font-bold text-gray-900 hover:text-indigo-600" %>
        </div>
        <ol class="flex flex-col divide-y divide-gray-100">
          <% board[:results].each_with_index do |result, i| %>
            <li class="flex items-center justify-between gap-2 px-1 py-1.5 <%= "rounded-md bg-indigo-50/70" if current_user && result.user_id == current_user.id %>">
              <span class="flex min-w-0 items-center gap-2 text-sm">
                <span class="w-6 shrink-0 text-center"><%= rank_badge(i) %></span>
                <%= link_to result.user.username, user_path(result.user.username), class: "truncate font-medium text-gray-800 hover:text-indigo-600" %>
              </span>
              <%= link_to display_score(game, result), game_result_path(game.name, result), class: "shrink-0 font-mono text-sm font-semibold tabular-nums text-gray-900 hover:text-indigo-600" %>
            </li>
          <% end %>
        </ol>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="rounded-xl bg-white px-6 py-12 text-center shadow-sm ring-1 ring-gray-950/5">
    <p class="text-3xl">🦗</p>
    <p class="mt-2 font-medium text-gray-700">No scores recorded for <%= @gameday.date %> yet.</p>
    <p class="mt-1 text-sm text-gray-500">Share your results with the <%= link_to "Telegram bot", telegram_setup_path, class: "font-medium text-indigo-600 hover:underline" %> and they appear here within 5 minutes.</p>
  </div>
<% end %>

<% if @presenter.unplayed.any? && (@presenter.played.any? || @presenter.pips) %>
  <div class="mt-8">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-400">No plays yet</h2>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <% @presenter.unplayed.each do |game| %>
        <%= link_to game_path(game.name, date: @gameday.date), title: game.display_name, class: "flex items-center gap-2 rounded-lg bg-white px-3 py-2 opacity-60 shadow-sm ring-1 ring-gray-950/5 transition hover:opacity-100" do %>
          <%= (image_tag game.logo, alt: game.name, class: "h-6 w-6 rounded") unless game.logo.nil? %>
          <span class="text-sm font-medium text-gray-600"><%= game.tile_name %></span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
