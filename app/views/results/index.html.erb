<% content_for :title, "#{@game.display_name} history · Daily Games" %>
<div class="mb-6 mt-2 flex flex-wrap items-end justify-between gap-3">
  <div class="flex items-center gap-3">
    <%= (image_tag @game.logo, alt: @game.name, class: "h-12 w-12 rounded-lg") unless @game.logo.nil? %>
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl"><%= @game.display_name %> history</h1>
      <div class="mt-0.5 flex gap-3 text-sm">
        <%= link_to "Play ↗", @game.url, target: "_blank", class: "font-semibold text-indigo-600 hover:underline" %>
        <%= link_to "Today's board", game_path(@game.name), class: "text-gray-500 hover:text-gray-800 hover:underline" %>
        <%= link_to "Record score", new_game_result_path(@game.name), class: "text-gray-500 hover:text-gray-800 hover:underline" %>
      </div>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% @results.each do |result| %>
    <div class="flex flex-col rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-950/5">
      <div class="flex items-baseline justify-between">
        <%= link_to Gameday.find(result.gameday_id).date, leaderboards_path(date: Gameday.find(result.gameday_id).date), class: "font-bold text-gray-900 hover:text-indigo-600" %>
        <%= link_to "##{result.edition}", game_result_path(@game.name, result), class: "text-sm font-medium text-gray-400 hover:text-indigo-600" %>
      </div>
      <p class="mt-1 font-mono text-xl font-bold tabular-nums text-indigo-600"><%= display_score(@game, result) %></p>
      <div class="mt-2 whitespace-pre-line break-words text-sm leading-6 text-gray-700"><%= ParseScore.new(result.score).parse.join("\n") %></div>
    </div>
  <% end %>
</div>
