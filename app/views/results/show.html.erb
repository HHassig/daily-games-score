<% content_for :title, "#{@game.display_name} result · Daily Games" %>
<% gameday = Gameday.find(@result.gameday_id) %>
<div class="mx-auto mt-6 max-w-md">
  <div class="flex flex-col items-center rounded-xl bg-white p-8 text-center shadow-sm ring-1 ring-gray-950/5">
    <%= (image_tag @game.logo, alt: @game.name, class: "mb-3 h-14 w-14 rounded-lg") unless @game.logo.nil? %>
    <h1 class="text-2xl font-bold text-gray-900"><%= @game.display_name %> <span class="font-medium text-gray-400">#<%= @result.edition %></span></h1>
    <p class="mt-0.5 text-sm text-gray-500"><%= User.find(@result.user_id).username %> · <%= gameday.date %></p>
    <p class="mt-3 font-mono text-3xl font-bold tabular-nums text-indigo-600"><%= display_score(@game, @result) %></p>
    <div class="mt-3 whitespace-pre-line break-words text-base leading-7 text-gray-700"><%= ParseScore.new(@result.score).parse.join("\n") %></div>
    <div class="mt-5 flex gap-3 text-sm">
      <%= link_to "Day leaderboard", leaderboards_path(date: gameday.date), class: "font-semibold text-indigo-600 hover:underline" %>
      <%= link_to "#{@game.display_name} history", game_results_path(@game.name), class: "text-gray-500 hover:text-gray-800 hover:underline" %>
    </div>
  </div>
</div>
