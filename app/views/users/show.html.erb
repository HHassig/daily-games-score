<% content_for :title, "#{@user.username} · Daily Games" %>
<div class="mb-6 mt-2 flex flex-wrap items-end justify-between gap-3">
  <div>
    <div class="flex items-center gap-3">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-indigo-600 text-xl font-bold text-white"><%= @user.username.to_s[0]&.upcase %></span>
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl"><%= @user.username %></h1>
        <p class="mt-0.5 text-sm text-gray-500">
          Following <%= @following.size %> · Followers <%= @followers.size %>
          <% if @user == current_user %>
            · <%= link_to "Edit profile", edit_user_path(@user.username), class: "text-indigo-600 hover:underline" %>
            · <%= link_to "Day history", gamedays_path, class: "text-indigo-600 hover:underline" %>
          <% end %>
        </p>
      </div>
    </div>
    <% if @user != current_user %>
      <% friendship = Friendship.find_by(follower_id: current_user.id, followee_id: @user.id) %>
      <div class="mt-3">
        <% if friendship %>
          <%= link_to "Unfollow", friendship_path(friendship), data: { turbo_method: :delete, turbo_confirm: "Unfollow #{@user.username}?" }, class: "rounded-md bg-white px-3 py-1.5 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
        <% else %>
          <%= link_to "Follow", friendships_path(user_id: @user.id), data: { turbo_method: :post }, class: "rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        <% end %>
      </div>
    <% end %>
  </div>
  <%= render "shared/date_nav", gameday: @gameday %>
</div>

<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
  <% @games.each do |game| %>
    <% result = Result.find_by(game: game, user: @user, gameday_id: @gameday.id) %>
    <div class="flex flex-col items-center rounded-xl bg-white p-4 text-center shadow-sm ring-1 ring-gray-950/5 <%= "opacity-70" if result.nil? %>">
      <%= (image_tag game.logo, alt: game.name, class: "mb-2 h-12 w-12 rounded-lg") unless game.logo.nil? %>
      <%= link_to game.display_name, game_path(game.name, date: @gameday.date), class: "font-bold text-gray-900 hover:text-indigo-600" %>
      <% if result %>
        <%= link_to display_score(game, result), game_result_path(game.name, result), class: "mt-1 font-mono text-2xl font-bold tabular-nums text-indigo-600 hover:text-indigo-500" %>
      <% else %>
        <p class="mt-2 text-sm text-gray-400">Not played</p>
      <% end %>
    </div>
  <% end %>
</div>
