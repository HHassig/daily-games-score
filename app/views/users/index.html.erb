<div class="flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <!-- <img class="mx-auto h-10 w-auto" src="https://tailwindui.com/img/logos/mark.svg?color=indigo&shade=600" alt="Your Company"> -->
    <h2 class="mt-6 text-center text-2xl font-bold leading-9 tracking-tight text-gray-900">Find friends</h2>
  </div>

  <div class="mt-4 sm:mx-auto sm:w-full sm:max-w-[480px]">
    <div class="bg-stone-50 px-6 py-12 shadow sm:rounded-lg sm:px-12">
      <div data-controller="refresh-list">
        <%= form_with url: users_path, method: :get, html: { class: "d-flex", data: { refresh_list_target: "form" } } do |f| %>
          <%= f.text_field :query,
                            class: "form-control bg-white p-2 w-full rounded-lg",
                            placeholder: "Username",
                            value: params[:query],
                            data: {
                              refresh_list_target: 'searchInput',
                              action: "keyup->refresh-list#update"
                            } %>
        <% end %>
        <div class="bg-slate-50 dark:bg-slate-950" data-refresh-list-target="list">
        </div>
      </div>
    </div>
  </div>
</div>
