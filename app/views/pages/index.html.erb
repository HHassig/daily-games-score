<% content_for :title, "All games · Daily Games" %>
<%= render "shared/page_header", title: "All games" %>

<% @games.group_by(&:network).sort_by { |network, _| [network.name == "New York Times" ? 0 : 1, network.name] }.each do |network, games| %>
  <h2 class="mb-3 mt-6 text-sm font-semibold uppercase tracking-wide text-gray-400 first:mt-0"><%= network.name %></h2>
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
    <% games.uniq { |g| pips?(g) ? "pips" : g.id }.each do |game| %>
      <div class="flex flex-col items-center rounded-xl bg-white p-4 text-center shadow-sm ring-1 ring-gray-950/5">
        <%= (image_tag game.logo, alt: game.name, class: "mb-2 h-12 w-12 rounded-lg") unless game.logo.nil? %>
        <%= link_to (pips?(game) ? "Pips" : game.display_name), game_path(game.name), class: "font-bold text-gray-900 hover:text-indigo-600" %>
        <div class="mt-2 flex gap-2">
          <%= link_to "Play", game.url, target: "_blank", class: "rounded-md bg-indigo-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-indigo-500" %>
          <%= link_to "Record", new_game_result_path(game.name), class: "rounded-md bg-white px-2.5 py-1 text-xs font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
